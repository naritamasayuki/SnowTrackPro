      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Free plan allows up to 5 saved sessions per year. Unlock permanent unlimited saving with a single one-time purchase." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "無料プランは1年間で5回まで滑走ログを保存できます。買い切りのプロプランで保存回数の上限を永久に解除できます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "免费版每年最多保存 5 次滑行记录。一次买断升级 Pro 方案，永久解锁无限保存。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "免費版每年最多保存 5 次滑行記錄。一次買斷升級 Pro 方案，永久解鎖無限保存。" } }
