    "tracking.recoveredSession": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovered your previous unfinished ski session automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の未完了セッションを自動復旧し、履歴に保存しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
