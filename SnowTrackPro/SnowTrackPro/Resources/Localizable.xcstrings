    "coaching.locked.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Compare your turn rhythm and arc against previous sessions and get tailored on-slope tips." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これまでの滑走データとターン傾向を比較し、変化点と次の一本に活きるワンポイントアドバイスを表示します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将本次转弯节奏与历史滑行对比，发现变化并获取针对性滑行建议。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將本次轉彎節奏與歷史滑行對比，發現變化並獲得針對性滑行建議。" } }
