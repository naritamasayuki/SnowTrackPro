    "paywall.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze every turn, braking distance, and speed line."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターン解析・制動距離・速度ヒートマップで滑りの質を極める。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深度分析每一次转弯、制动距离与速度热力图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深度分析每一次轉彎、制動距離與速度熱力圖。"
          }
        }
      }
    },
