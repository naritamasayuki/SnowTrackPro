    "history.empty.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your iPhone in your pocket and start tracking to record your runs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポケットにiPhoneを入れて計測を開始すると、滑走ログがここに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将iPhone放入口袋并开始记录，您的滑行日志将保存在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將iPhone放入口袋並開始記錄，您的滑行日誌將保存在此處。"
          }
        }
      }
    },
