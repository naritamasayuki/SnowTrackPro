    "paywall.autoRenewNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment will be charged to your Apple Account at confirmation of purchase. Subscription automatically renews unless canceled at least 24 hours before the end of the current period. Manage or cancel anytime in App Store Account Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いは購入確定時に Apple Account に課金されます。サブスクリプションは期間終了の24時間前までに解約しない限り自動更新されます。管理・解約は App Store のアカウント設定からいつでも行えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认购买后将通过您的 Apple 账户扣款。除非在当前订阅期结束前至少 24 小时取消，否则订阅将自动续订。您可随时在 App Store 账户设置中管理或取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認購買後將透過您的 Apple 帳號扣款。除非在目前訂閱期結束前至少 24 小時取消，否則訂閱將自動續訂。您可隨時在 App Store 帳號設定中管理或取消。"
          }
        }
      }
    },
